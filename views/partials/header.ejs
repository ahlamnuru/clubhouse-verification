<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> | Clubhouse</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Clubhouse</a>
      <nav aria-label="Main navigation">
        <a href="/">Messages</a>
        <% if (currentUser) { %>
          <a href="/messages/new">New message</a>
          <% if (!currentUser.isMember && !currentUser.isAdmin) { %><a href="/join">Join the club</a><% } %>
          <% if (!currentUser.isAdmin) { %><a href="/admin-access">Admin access</a><% } %>
          <form action="/logout" method="post" class="nav-form"><button class="link-button" type="submit">Log out</button></form>
        <% } else { %>
          <a href="/login">Log in</a>
          <a href="/signup">Sign up</a>
        <% } %>
      </nav>
    </header>
    <main class="container">
